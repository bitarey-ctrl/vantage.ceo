# ============================================================
# VANTAGE — Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git.
# ============================================================

# ─── Supabase ────────────────────────────────────────────────
# From: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── AI — Anthropic (Primary) ────────────────────────────────
# From: https://console.anthropic.com/keys
# Used for: consequence mapping, brief generation, blind spot detection, health scoring
ANTHROPIC_API_KEY=sk-ant-...

# ─── Signal Sources ──────────────────────────────────────────
# NewsAPI.org — primary news source (FREE: 100 req/day, 1000/month)
# Sign up at: https://newsapi.org/register
# WITHOUT this key, signals come only from RSS feeds (still works,
# but you get fewer signals).
NEWSAPI_KEY=your-newsapi-key-here

# Perplexity API — currently unused but reserved for future research agent
# From: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# ─── App Configuration ───────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=VANTAGE

# ─── Cron Security ───────────────────────────────────────────
# Random secret to protect cron endpoints from unauthorized calls
# Generate with: openssl rand -base64 32
CRON_SECRET=your-random-secret-here

# ─── Optional: Stripe (Payments) ─────────────────────────────
# From: https://dashboard.stripe.com/apikeys
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# ─── Resend (Email — daily morning briefing) ─────────────────
# From: https://resend.com/api-keys
# Required for the daily briefing cron to send email. Real key goes
# in .env.local (added manually) — this is just the placeholder.
RESEND_API_KEY=re_your-resend-api-key-here
# Verified sender. Use onboarding@resend.dev for local testing, or your
# own verified domain in production.
RESEND_FROM_EMAIL=VANTAGE <briefs@yourdomain.com>

# ─── Optional: OpenAI (AI Fallback) ──────────────────────────
# Used as fallback if Anthropic API is unavailable
# OPENAI_API_KEY=sk-...
